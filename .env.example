# Plantilla de variables. Copia a .env y rellena con valores propios.
# El .env REAL nunca se sube a git (está en .gitignore).
# En el servidor genera secretos fuertes (ver guía de despliegue):
#   openssl rand -base64 48   -> JWT_SECRET
#   openssl rand -base64 24   -> POSTGRES_PASSWORD

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTE_VALOR
JWT_SECRET=GENERA_UN_SECRETO_NUEVO_BASE64

# IP pública del Droplet (sin barra final). Ej: http://203.0.113.10
FRONT_ORIGIN=http://TU_IP_DEL_DROPLET
SERVER_IP=TU_IP_DEL_DROPLET

# En producción NO se usa: nginx hace proxy de /api al gateway (mismo origen).
# VITE_API_BASE_URL=/api

# --- Integración Jira (solicitudes-service) ---
# Para activar el sync con Jira en producción. El API token se genera en:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Deja JIRA_ENABLED=false si no quieres tocar Jira en el servidor.
JIRA_ENABLED=false
JIRA_BASE_URL=https://antent.atlassian.net
JIRA_EMAIL=tu-correo@ejemplo.com
JIRA_API_TOKEN=PEGA_TU_API_TOKEN_AQUI
JIRA_PROJECT_KEY=SCRUM
JIRA_CAMBIOS_PROJECT_KEY=CDCCJ
JIRA_ISSUE_TYPE=Tarea

# --- Monitoreo de eventos (solicitudes-service, API DigitalOcean) ---
# Token de LECTURA de DO (API -> Tokens). Sin token el monitoreo queda apagado.
DO_MONITOREO_ENABLED=false
DO_API_TOKEN=
DO_DROPLET_ID=

# --- Gestion de Continuidad y DRP ---
# Token compartido del cron de respaldos (scripts/backup/droplet/).
# Generar con:  openssl rand -hex 24
CONTINUIDAD_BACKUP_TOKEN=
